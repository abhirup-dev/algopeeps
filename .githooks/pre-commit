#!/bin/sh
# Quality gates for plain `git commit` (same commands as the worktrunk pre-commit
# hooks in .config/wt.toml). Each project's check runs only when its files are
# staged, so neither slows the other. Enable once per clone:
#   git config core.hooksPath .githooks
set -e
staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | grep -q '^canvas/'; then
  (cd canvas && bun run check)
fi
if printf '%s\n' "$staged" | grep -q '^elkdraw/'; then
  (cd elkdraw && bun run check)
fi
