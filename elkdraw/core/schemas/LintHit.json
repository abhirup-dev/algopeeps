{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "text-overflow",
        "text-wrapped",
        "label-on-node",
        "label-on-label",
        "label-on-border",
        "arrow-through-node",
        "arrow-through-label",
        "label-on-own-arrowhead",
        "node-overlap",
        "dangling-endpoint",
        "outside-zone",
        "crossing"
      ]
    },
    "ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bbox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": ["error", "info"]
    },
    "hint": {
      "type": "string"
    },
    "suppressed": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["code", "ids", "bbox", "severity", "hint"],
  "additionalProperties": false
}
